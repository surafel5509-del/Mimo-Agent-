# ---------------------------------------------------------------
# MIMO AGENT configuration. Copy to .env.local and fill in values.
# NEVER commit real secrets. NVIDIA_API_KEY is server-only.
# ---------------------------------------------------------------
APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL (local Docker, Supabase, Neon, RDS, ...). pgvector recommended.
DATABASE_URL=postgres://mimo:mimo@localhost:5432/mimo_agent
# Set to true for managed providers that require TLS (e.g. Supabase, Neon).
DATABASE_SSL=false

# NVIDIA NIM (OpenAI-compatible Chat Completions)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Chat model id available on your NVIDIA account. Must support chat completions.
# Examples (confirm each is enabled for your account and check its model card for vision/tool support):
#   meta/llama-3.1-70b-instruct, mistralai/mistral-large-4-1t-a52b
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# Optional extra models shown in the model selector (comma separated).
NVIDIA_MODEL_OPTIONS=
# Vision model for image analysis. Leave empty to disable image analysis.
NVIDIA_VISION_MODEL=
# Embedding model for semantic memory. Leave empty for full-text retrieval only.
NVIDIA_EMBEDDING_MODEL=
# Must equal the embedding model's output dimension (migration 002 fixes it).
MEMORY_EMBEDDING_DIM=1024
# auto | native | json   (tool-calling protocol)
NVIDIA_TOOL_CALLING=auto
NVIDIA_TIMEOUT_MS=60000
NVIDIA_MAX_RETRIES=2

# Web search (optional). Options: none | langsearch | brave. Keys are server-side only.
WEB_SEARCH_PROVIDER=none
LANGSEARCH_API_KEY=
BRAVE_SEARCH_API_KEY=

# Auth & sessions
SESSION_TTL_DAYS=14
# Set true behind HTTPS in production (defaults to true when NODE_ENV=production).
AUTH_COOKIE_SECURE=false
# Comma separated emails automatically promoted to the admin role on registration.
ADMIN_EMAILS=
EMAIL_VERIFICATION_REQUIRED=false
# Development only: return verification/reset links in API responses for local testing.
DEV_EXPOSE_AUTH_LINKS=true
# Transactional email (SMTP URL). Without it, links are logged server-side only in development.
SMTP_URL=

# Uploads (stored on local disk; use a mounted volume or swap the storage adapter in production)
UPLOAD_DIR=./.data/uploads
MAX_UPLOAD_MB=10

# Agent limits and cost controls
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_CONTEXT_TOKEN_BUDGET=12000
AGENT_DAILY_TOKEN_BUDGET=2000000
AGENT_TOOL_TIMEOUT_MS=20000

LOG_LEVEL=info
